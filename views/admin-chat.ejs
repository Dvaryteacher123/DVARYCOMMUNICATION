<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DVaryHub — Admin Chat</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
  body { background: #0f172a; color: #e2e8f0; padding: 20px; min-height: 100vh; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }
  h1 { color: #38bdf8; font-size: 22px; }

  .btn {
    background: #38bdf8;
    color: #0f172a;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: 0.2s;
    display: inline-block;
    margin-left: 6px;
  }
  .btn:hover { background: #0ea5e9; }

  .rooms {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 16px;
  }
  @media (max-width: 700px) {
    .rooms { grid-template-columns: 1fr; }
  }

  .room-list {
    background: #1e293b;
    padding: 12px;
    border-radius: 12px;
    max-height: 80vh;
    overflow-y: auto;
  }
  .room-list h3 {
    color: #38bdf8;
    margin-bottom: 10px;
    font-size: 15px;
  }
  .room-item {
    padding: 10px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 6px;
    background: #0f172a;
    font-size: 13px;
    word-break: break-all;
    transition: 0.2s;
    border-left: 3px solid transparent;
  }
  .room-item:hover {
    background: #334155;
  }
  .room-item.active {
    background: #38bdf8;
    color: #0f172a;
    border-left-color: #0ea5e9;
    font-weight: bold;
  }

  .chat-area {
    background: #1e293b;
    padding: 16px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    min-height: 500px;
  }
  #activeRoom {
    margin-bottom: 10px;
    color: #38bdf8;
    font-size: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid #334155;
  }

  #chatBox {
    flex: 1;
    min-height: 400px;
    max-height: 65vh;
    overflow-y: auto;
    background: #0f172a;
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .msg {
    padding: 8px 12px;
    margin: 4px 0;
    border-radius: 8px;
    max-width: 75%;
    word-wrap: break-word;
    font-size: 14px;
    line-height: 1.4;
  }
  .admin { background: #38bdf8; color: #0f172a; margin-left: auto; }
  .customer { background: #334155; }

  .empty {
    color: #94a3b8;
    font-size: 14px;
    text-align: center;
    padding: 40px 10px;
  }

  .input-row { display: flex; gap: 8px; }
  input {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #0f172a;
    color: #e2e8f0;
    outline: none;
    font-size: 14px;
  }
  input:focus { border-color: #38bdf8; }
  input:disabled { opacity: 0.5; }
</style>
</head>
<body>

  <header>
    <h1>👨‍💼 Admin Chat</h1>
    <div>
      <a href="/admin/products" class="btn">📦 Bidhaa</a>
      <a href="/" class="btn">👤 Mteja</a>
    </div>
  </header>

  <div class="rooms">
    <!-- Orodha ya wateja -->
    <div class="room-list">
      <h3>💬 Wateja</h3>
      <div id="roomList"><p class="empty">Inapakia...</p></div>
    </div>

    <!-- Eneo la chat -->
    <div class="chat-area">
      <h3 id="activeRoom">Chagua mteja kuanza</h3>
      <div id="chatBox">
        <p class="empty">Chagua mteja kutoka kushoto kuona mazungumzo yao.</p>
      </div>
      <div class="input-row">
        <input id="msgInput" placeholder="Jibu mteja..." disabled />
        <button class="btn" onclick="sendMsg()" id="sendBtn" disabled>Tuma</button>
      </div>
    </div>
  </div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.emit('adminJoin'); // Admin anaingia kwenye room 'admin' kupokea jumbe zote

  let currentRoom = null;
  const chatBox = document.getElementById('chatBox');
  const msgInput = document.getElementById('msgInput');
  const sendBtn = document.getElementById('sendBtn');
  const activeRoomLabel = document.getElementById('activeRoom');

  // ===== Pakia orodha ya rooms =====
  async function loadRooms() {
    try {
      const msgs = await fetch('/admin/api/all-messages').then(r => r.json());
      const rooms = [...new Set(msgs.map(m => m.roomId))];
      const list = document.getElementById('roomList');

      if (!rooms.length) {
        list.innerHTML = '<p class="empty">Hakuna wateja bado.</p>';
        return;
      }

      list.innerHTML = rooms.map(r =>
        `<div class="room-item" data-room="${r}" onclick="openRoom('${r}')">${r}</div>`
      ).join('');

      // Weka active kama currentRoom ipo
      if (currentRoom) {
        document.querySelectorAll('.room-item').forEach(el => {
          el.classList.toggle('active', el.dataset.room === currentRoom);
        });
      }
    } catch (err) {
      console.error('Load rooms error:', err);
    }
  }

  // ===== Fungua room =====
  async function openRoom(roomId) {
    currentRoom = roomId;
    activeRoomLabel.textContent = '💬 Room: ' + roomId;
    msgInput.disabled = false;
    sendBtn.disabled = false;

    // Weka active class
    document.querySelectorAll('.room-item').forEach(el => {
      el.classList.toggle('active', el.dataset.room === roomId);
    });

    // Pakia jumbe za room
    try {
      const msgs = await fetch('/api/messages/' + roomId).then(r => r.json());
      chatBox.innerHTML = '';
      if (!msgs.length) {
        chatBox.innerHTML = '<p class="empty">Hakuna jumbe bado.</p>';
        return;
      }
      msgs.forEach(m => addMsg(m.sender, m.text));
      msgInput.focus();
    } catch (err) {
      console.error('Load messages error:', err);
      chatBox.innerHTML = '<p class="empty">Imeshindwa kupakia jumbe.</p>';
    }
  }

  // ===== Ongeza ujumbe =====
  function addMsg(sender, text) {
    // Ondoa "empty" kama ipo
    const empty = chatBox.querySelector('.empty');
    if (empty) empty.remove();

    const div = document.createElement('div');
    div.className = 'msg ' + (sender === 'admin' ? 'admin' : 'customer');
    div.textContent = (sender === 'customer' ? '👤 ' : '👨‍💼 ') + text;
    chatBox.appendChild(div);
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  // ===== Pokea jumbe mpya (real-time) =====
  socket.on('message', (data) => {
    // Kama ni room tunayoiona sasa, ionyeshe
    if (data.roomId === currentRoom) {
      addMsg(data.sender, data.text);
    }
    // Kama ni room mpya (mteja mpya), update orodha
    const list = document.getElementById('roomList');
    const exists = list.querySelector(`[data-room="${data.roomId}"]`);
    if (!exists) {
      loadRooms();
    }
  });

  // ===== Tuma jibu =====
  async function sendMsg() {
    if (!currentRoom) {
      alert('Chagua mteja kwanza');
      return;
    }
    const text = msgInput.value.trim();
    if (!text) return;

    try {
      await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roomId: currentRoom, sender: 'admin', text })
      });

      socket.emit('chatMessage', { roomId: currentRoom, sender: 'admin', text });
      msgInput.value = '';
    } catch (err) {
      console.error('Send error:', err);
      alert('Ujumbe umeshindwa kutumwa.');
    }
  }

  // ===== Enter kutuma =====
  msgInput.addEventListener('keypress', e => {
    if (e.key === 'Enter') sendMsg();
  });

  // ===== Anza =====
  loadRooms();

  // Refresh orodha kila sekunde 10 (kama wateja wapya wanaingia)
  setInterval(loadRooms, 10000);
</script>
</body>
</html>
