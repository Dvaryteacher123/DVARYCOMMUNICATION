<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DVaryHub — Chat</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
  body { background: #0f172a; color: #e2e8f0; min-height: 100vh; padding: 20px; }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
  }
  h1 { color: #38bdf8; font-size: 24px; }
  .btn {
    background: #38bdf8;
    color: #0f172a;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: 0.2s;
  }
  .btn:hover { background: #0ea5e9; }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 800px) {
    .layout { grid-template-columns: 1fr; }
  }

  .card {
    background: #1e293b;
    padding: 16px;
    border-radius: 12px;
  }
  .card h2 {
    color: #38bdf8;
    margin-bottom: 12px;
    font-size: 18px;
  }

  /* Chat */
  #chatBox {
    height: 350px;
    overflow-y: auto;
    background: #0f172a;
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 10px;
  }
  .msg {
    padding: 8px 12px;
    margin: 4px 0;
    border-radius: 8px;
    max-width: 80%;
    word-wrap: break-word;
    font-size: 14px;
    line-height: 1.4;
  }
  .me { background: #38bdf8; color: #0f172a; margin-left: auto; }
  .other { background: #334155; }

  .input-row { display: flex; gap: 8px; }
  input {
    flex: 1;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #0f172a;
    color: #e2e8f0;
    outline: none;
  }
  input:focus { border-color: #38bdf8; }

  /* Bidhaa */
  .grid-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
    max-height: 400px;
    overflow-y: auto;
    padding-right: 4px;
  }
  .product {
    background: #0f172a;
    border-radius: 8px;
    padding: 8px;
    transition: transform 0.2s;
  }
  .product:hover { transform: translateY(-2px); }
  .product img {
    width: 100%;
    height: 100px;
    object-fit: cover;
    border-radius: 6px;
  }
  .product h3 { font-size: 13px; margin: 6px 0 2px; }
  .product p { color: #38bdf8; font-weight: bold; font-size: 14px; }
</style>
</head>
<body>

  <header>
    <h1>🛒 DVaryHub</h1>
    <a href="/ai" class="btn">🤖 AI Msaidizi</a>
  </header>

  <div class="layout">
    <!-- CHAT -->
    <div class="card">
      <h2>💬 Live Chat na Admin</h2>
      <div id="chatBox"></div>
      <div class="input-row">
        <input id="msgInput" placeholder="Andika ujumbe..." />
        <button class="btn" onclick="sendMsg()">Tuma</button>
      </div>
    </div>

    <!-- BIDHAA -->
    <div class="card">
      <h2>📦 Bidhaa Zetu</h2>
      <div id="products" class="grid-products">Inapakia...</div>
    </div>
  </div>

<script src="/socket.io/socket.io.js"></script>
<script>
  // ==== Socket ====
  const socket = io();

  // ==== Room ID (inahifadhiwa kwenye localStorage) ====
  let rid = localStorage.getItem('rid');
  if (!rid) {
    rid = 'room-' + Math.random().toString(36).slice(2, 10);
    localStorage.setItem('rid', rid);
  }
  const roomId = rid;

  socket.emit('joinRoom', roomId);

  // ==== Pakia jumbe za awali ====
  fetch('/api/messages/' + roomId)
    .then(r => r.json())
    .then(msgs => {
      msgs.forEach(m => addMsg(m.sender, m.text));
    })
    .catch(err => console.error('Chat load error:', err));

  // ==== Pakia bidhaa ====
  fetch('/api/products')
    .then(r => r.json())
    .then(items => {
      const box = document.getElementById('products');
      if (!items.length) {
        box.innerHTML = '<p style="font-size:13px;color:#94a3b8;">Hakuna bidhaa bado.</p>';
        return;
      }
      box.innerHTML = items.map(p => `
        <div class="product">
          <img src="${p.imageUrl}" alt="${p.name}" onerror="this.src='https://via.placeholder.com/150'" />
          <h3>${p.name}</h3>
          <p>TSh ${p.price}</p>
        </div>
      `).join('');
    })
    .catch(err => console.error('Products load error:', err));

  // ==== Pokea jumbe mpya ====
  socket.on('message', (data) => {
    if (data.roomId === roomId) {
      addMsg(data.sender, data.text);
    }
  });

  // ==== Ongeza ujumbe kwenye box ====
  function addMsg(sender, text) {
    const box = document.getElementById('chatBox');
    const div = document.createElement('div');
    div.className = 'msg ' + (sender === 'customer' ? 'me' : 'other');
    div.textContent = (sender === 'admin' ? '👨‍💼 ' : '') + text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  }

  // ==== Tuma ujumbe ====
  async function sendMsg() {
    const input = document.getElementById('msgInput');
    const text = input.value.trim();
    if (!text) return;

    try {
      await fetch('/api/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ roomId, sender: 'customer', text })
      });

      socket.emit('chatMessage', { roomId, sender: 'customer', text });
      input.value = '';
    } catch (err) {
      console.error('Send error:', err);
      alert('Ujumbe umeshindwa kutumwa. Jaribu tena.');
    }
  }

  // ==== Enter kutuma ====
  document.getElementById('msgInput').addEventListener('keypress', e => {
    if (e.key === 'Enter') sendMsg();
  });
</script>
</body>
</html>
