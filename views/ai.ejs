<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DVaryHub — AI Msaidizi</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
  body {
    background: #0f172a;
    color: #e2e8f0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    padding: 20px;
  }

  .container {
    width: 100%;
    max-width: 700px;
    background: #1e293b;
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 40px);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    gap: 10px;
  }
  h1 { color: #38bdf8; font-size: 22px; }

  .btn {
    background: #38bdf8;
    color: #0f172a;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: 0.2s;
  }
  .btn:hover { background: #0ea5e9; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  #chatBox {
    flex: 1;
    overflow-y: auto;
    background: #0f172a;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 12px;
  }

  .msg {
    padding: 10px 14px;
    margin: 6px 0;
    border-radius: 10px;
    max-width: 85%;
    line-height: 1.5;
    font-size: 14px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  .me { background: #38bdf8; color: #0f172a; margin-left: auto; }
  .ai { background: #334155; }
  .loading { color: #94a3b8; font-style: italic; }

  .input-row { display: flex; gap: 8px; }
  input {
    flex: 1;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #0f172a;
    color: #e2e8f0;
    outline: none;
    font-size: 14px;
  }
  input:focus { border-color: #38bdf8; }
</style>
</head>
<body>

  <div class="container">
    <header>
      <h1>🤖 DVaryHub AI</h1>
      <a href="/" class="btn">← Rudi</a>
    </header>

    <div id="chatBox">
      <div class="msg ai">Habari! Mimi ni msaidizi wa DVaryHub. Niulize kitu chochote kuhusu bidhaa zetu au msaada wowote. 😊</div>
    </div>

    <div class="input-row">
      <input id="aiInput" placeholder="Uliza AI..." autocomplete="off" />
      <button id="sendBtn" class="btn" onclick="askAI()">Tuma</button>
    </div>
  </div>

<script>
  const box = document.getElementById('chatBox');
  const input = document.getElementById('aiInput');
  const sendBtn = document.getElementById('sendBtn');

  function addMsg(text, cls) {
    const div = document.createElement('div');
    div.className = 'msg ' + cls;
    div.textContent = text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
    return div;
  }

  async function askAI() {
    const prompt = input.value.trim();
    if (!prompt) return;

    // Onyesha swali la mtumiaji
    addMsg(prompt, 'me');
    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;

    // Loading indicator
    const loading = addMsg('AI inafikiri...', 'ai loading');

    try {
      const res = await fetch('/api/ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt })
      });

      const data = await res.json();
      loading.remove();

      if (res.ok && data.reply) {
        addMsg(data.reply, 'ai');
      } else {
        addMsg('⚠️ ' + (data.error || 'Hitilafu imetokea'), 'ai');
      }
    } catch (err) {
      loading.remove();
      addMsg('⚠️ Mtandao umeshindwa. Jaribu tena.', 'ai');
      console.error('AI error:', err);
    } finally {
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  // Enter kutuma
  input.addEventListener('keypress', e => {
    if (e.key === 'Enter') askAI();
  });

  // Focus mwanzo
  input.focus();
</script>
</body>
</html>
